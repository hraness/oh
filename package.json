{
  "name": "@hraness/oh",
  "version": "0.1.0",
  "description": "open-source tools for agentic research",
  "type": "module",
  "license": "MIT",
  "author": "Hraness",
  "homepage": "https://oh.computer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/oh.git"
  },
  "bugs": {
    "url": "https://github.com/hraness/oh/issues"
  },
  "keywords": [
    "agentic-research",
    "knowledge-graph",
    "ontology",
    "sqlite"
  ],
  "private": false,
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "oh": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "import": "./dist/sqlite/index.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js"
    },
    "./semantic": {
      "types": "./dist/semantic.d.ts",
      "import": "./dist/semantic.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "spec",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts ./src/sdk.ts ./src/sqlite/index.ts ./src/sync.ts ./src/semantic.ts ./src/cli.ts --outdir ./dist --target bun --format esm --external bun:sqlite",
    "build:types": "tsc -p tsconfig.build.json",
    "check": "bun run typecheck && bun test && bun run build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.17.4 <1",
    "@tobilu/qmd": "2.5.3"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "@tobilu/qmd": {
      "optional": true
    }
  }
}
