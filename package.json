{
  "name": "@hraness/oh",
  "version": "0.3.0",
  "description": "open-source tools for agentic research",
  "type": "module",
  "license": "MIT",
  "author": "Hraness",
  "homepage": "https://oh.computer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/oh.git"
  },
  "bugs": {
    "url": "https://github.com/hraness/oh/issues"
  },
  "keywords": [
    "agentic-research",
    "knowledge-graph",
    "ontology",
    "sqlite"
  ],
  "private": false,
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "oh": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./libsql": {
      "types": "./dist/libsql.d.ts",
      "import": "./dist/libsql.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "import": "./dist/sqlite/index.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js"
    },
    "./semantic": {
      "types": "./dist/semantic.d.ts",
      "import": "./dist/semantic.js"
    },
    "./semantic-cloud": {
      "types": "./dist/semantic-cloud.d.ts",
      "import": "./dist/semantic-cloud.js"
    },
    "./memory-page": {
      "types": "./dist/memory-page.d.ts",
      "import": "./dist/memory-page.js"
    },
    "./projection": {
      "types": "./dist/projection-public.d.ts",
      "import": "./dist/projection-public.js"
    },
    "./experimental/projection-suss": {
      "types": "./dist/projection-suss.d.ts",
      "import": "./dist/projection-suss.js"
    },
    "./experimental/memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "spec",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:portable && bun run build:types",
    "build:js": "bun build ./src/index.ts ./src/sdk.ts ./src/sqlite/index.ts ./src/sync.ts ./src/semantic.ts ./src/cli.ts --outdir ./dist --target bun --format esm --external bun:sqlite",
    "build:portable": "bun build ./src/store.ts ./src/libsql.ts ./src/projection-public.ts ./src/projection-suss.ts ./src/memory.ts ./src/memory-page.ts ./src/semantic-cloud.ts --outdir ./dist --target node --format esm --external @suss/datalog",
    "build:types": "tsc -p tsconfig.build.json",
    "check": "bun run typecheck && bun run typecheck:scripts && bun run test && bun run build && bun run test:types:node && bun run test:node && bun run test:node-projection && bun run test:package",
    "test:node": "node ./tests/node-portable.mjs",
    "test:types:node": "tsc -p tsconfig.node-portable.json --noEmit",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "release:preflight": "bun run ./scripts/check-release-provider-preflight.ts",
    "test": "bun test ./src ./tests ./site/tests/source.test.ts",
    "test:node-projection": "node --test ./scripts/projection-node.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit"
  },
  "devDependencies": {
    "@suss/datalog": "0.20.0",
    "@types/bun": "1.3.14",
    "sigstore": "4.1.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.17.4 <1",
    "@suss/datalog": "0.20.0",
    "@tobilu/qmd": "2.5.3"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "@suss/datalog": {
      "optional": true
    },
    "@tobilu/qmd": {
      "optional": true
    }
  }
}
