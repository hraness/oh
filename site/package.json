{
  "name": "oh-site",
  "version": "0.14.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:theme": "bun scripts/check-paper-theme.mjs",
    "dev": "bun run build:theme && next dev --webpack",
    "prebuild": "bun run build:theme && bun run test",
    "build": "next build --webpack",
    "postbuild": "bun test ./tests/runtime.test.ts",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "test": "bun run check:theme && bun test ./tests/source.test.ts ./tests/home.test.tsx ./tests/blog.test.tsx ./tests/compare.test.tsx ./tests/editorial-layer.test.ts ./tests/indexnow.test.ts ./tests/launch.test.ts ./tests/social-image.test.ts ./scripts/owned-browser.test.ts ./analytics.test.ts",
    "test:browser": "bun scripts/check-stylex-browser.mjs",
    "typecheck": "tsc --noEmit",
    "search:notify": "bun scripts/submit-indexnow.ts",
    "build:theme": "bun scripts/build-theme-bootstrap.ts",
    "launch:kit": "bun scripts/write-social-kit.ts"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.35.0",
    "@hraness/posthog": "https://github.com/hraness/posthog/releases/download/v0.3.9/hraness-posthog-0.3.9.tgz",
    "@hraness/site-footer": "https://github.com/hraness/site-footer/releases/download/v0.20.5/hraness-site-footer-0.20.5.tgz",
    "@hraness/ui": "github:hraness/ui#v0.5.18",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.13.0",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.62.0",
    "typescript": "6.0.3"
  },
  "type": "module"
}
