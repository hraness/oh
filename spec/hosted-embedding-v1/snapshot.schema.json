{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh.computer/spec/hosted-embedding-v1/snapshot.schema.json",
  "title": "Oh precomputed hosted embedding snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "profileSha256",
    "sourceSha256",
    "records",
    "queries",
    "embeddings",
    "receipts"
  ],
  "properties": {
    "protocol": {
      "const": "oh.semantic-hosted-snapshot.v1"
    },
    "profileSha256": {
      "const": "4db0f52aac5759d5fd37efc489e4c95f35b0f815ca19dec41addf72926061454"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/query"
      }
    },
    "embeddings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/embedding"
      }
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "recordSha256",
        "documentSha256",
        "chunks"
      ],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
        },
        "recordSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "documentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "inputSha256",
              "embeddingIndex"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 33554432
              },
              "end": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              },
              "inputSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "embeddingIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              }
            }
          }
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "querySha256",
        "embeddingIndex"
      ],
      "properties": {
        "querySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "embeddingIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "inputSha256",
        "vector",
        "receiptIndex",
        "inputIndex"
      ],
      "properties": {
        "role": {
          "enum": [
            "document",
            "query"
          ]
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "vector": {
          "type": "array",
          "minItems": 1536,
          "maxItems": 1536,
          "items": {
            "type": "number"
          }
        },
        "receiptIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "inputIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritySha256",
        "settlementSha256",
        "requestSha256",
        "responseSha256",
        "profileSha256",
        "role",
        "inputSha256s",
        "knownCostMicros",
        "reservationMicros",
        "latencyMs",
        "physicalCalls"
      ],
      "properties": {
        "authoritySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "settlementSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "responseSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profileSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "role": {
          "enum": [
            "document",
            "query"
          ]
        },
        "inputSha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "knownCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reservationMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 300000
        },
        "physicalCalls": {
          "const": 1
        }
      }
    }
  }
}
